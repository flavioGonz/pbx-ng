# ============================================================================
#  PBX-NG · .env (NO se versiona — ver .gitignore)
#  Los SECRETOS se dejan VACÍOS a propósito: el instalador (install.sh) los
#  genera por-deployment con openssl. NUNCA pongas contraseñas de ejemplo acá.
#  Para 2 VMs: el 'core' genera edge-join.env con los secretos compartidos y el
#  'edge' los consume — no copies secretos a mano.
# ============================================================================

# ---- Módulos activos (perfiles compose) ----
COMPOSE_PROFILES=core

# ---- App / dominio ----
DOMAIN=
PUBLIC_IP=
TENANT_MODE=single
DEFAULT_COMPANY=Mi Empresa

# ---- Base de datos (DB_PASS lo genera el instalador) ----
# DB_HOST lo usa SOLO Asterisk (host network): Postgres ata 5432 a 127.0.0.1 del
# host, así que acá va 127.0.0.1. La API llega por la red interna (postgres).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=pbxng
DB_USER=pbxng
DB_PASS=

# ---- Hosts de servicios (el instalador los completa según el rol) ----
ASTERISK_HOST=127.0.0.1
TURN_HOST=
VOZ_HOST=
MEDIA_HOST=
NPM_HOST=

# ---- Secretos (VACÍOS → los genera install.sh; no los pongas a mano) ----
JWT_SECRET=
ARI_USER=pbxng
ARI_PASS=
AMI_USER=pbxng-ami
AMI_PASS=
TURN_USER=pbxng
TURN_PASS=
TURN_CLI_PASS=
# Contraseña inicial del usuario 'admin' (el instalador la genera; se pide
# cambiarla en el primer ingreso). Si queda vacía, app.js usa 'admin' (inseguro).
ADMIN_DEFAULT_PASS=

# ---- Panel (dashboard) ----
# Interfaz del host donde se publica :3001. El instalador pone 127.0.0.1 cuando el
# perfil proxy (NPM) esta en este mismo compose (NPM llega por la red bridge a
# dashboard:3001 y se entra por 443); si :3001 quedara en 0.0.0.0 alguien de la LAN
# podria entrar directo con un X-Forwarded-For inventado y falsificar la IP del rate
# limit del login. Sin proxy (o con NPM en OTRO host) va 0.0.0.0.
DASHBOARD_BIND=0.0.0.0
# Cantidad de reverse proxies delante del panel (se pasa como TRUST_PROXY). Vacio =
# el panel infiere 1 si el perfil proxy esta en COMPOSE_PROFILES y 0 si no. Ponerlo
# en 1 cuando el proxy (NPM u otro nginx) corre en OTRO host/CT: si no, el panel
# descarta su X-Forwarded-For y la API ve la IP del proxy para todos los usuarios
# (el limite de 50 fallos/10 min por IP bloquearia a toda la empresa).
DASHBOARD_TRUST_PROXY=

# ---- Intercom (go2rtc) ----
GO2RTC_MGMT=http://go2rtc:1984

# ---- Release por imagen (deploy por pull/bundle) ----
PBXNG_REGISTRY=pbxng
PBXNG_VERSION=latest
