#!/usr/bin/env bash
# ============================================================================
#  pbxng-ctl · gestiona MODULOS = PERFILES = CONTENEDORES del stack PBX-NG.
#  Un contenedor existe SOLO si su modulo esta activo (COMPOSE_PROFILES en .env).
#
#  pbxng-ctl status                 perfiles activos + contenedores
#  pbxng-ctl enable  <modulo>       agrega el perfil y CREA sus contenedores
#  pbxng-ctl disable <modulo>       DESTRUYE los contenedores del modulo y saca el perfil
#  pbxng-ctl up | down | ps         aplica el COMPOSE_PROFILES actual
#  pbxng-ctl reconcile              sincroniza contenedores <-> COMPOSE_PROFILES del .env
#  pbxng-ctl backup [args]          respaldo ahora (backup-cli.js en la API; --keep=N, etc.)
#  pbxng-ctl drain [--yes]          drena Asterisk (sin llamadas nuevas, espera a las activas) y lo para
#  Modulos: core(siempre) turn ai intercom proxy   (el SBC es otro producto: SBC-NG)
#
#  Flags: --yes  (no preguntar antes de cortar llamadas al recrear Asterisk)
#  Antes de un up/enable/reconcile que RECREE asterisk se drena (asterisk-drain.sh):
#  recrearlo con llamadas activas las corta. `reconcile` corre desde un timer sin
#  terminal, asi que drena sin preguntar (espera acotada) en vez de quedarse trabado.
# ============================================================================
set -euo pipefail
DIR="${PBXNG_DIR:-/opt/pbx-ng/docker}"
[ -f "$DIR/docker-compose.yml" ] || { echo "No encuentro $DIR/docker-compose.yml (exporta PBXNG_DIR)"; exit 1; }
cd "$DIR"
ENVF="$DIR/.env"
MODULES="core turn ai intercom proxy"   # el SBC es otro producto (SBC-NG), no un modulo de la central
# Que compose usa esta instalacion (install.sh --release deja docker-compose.release.yml).
CF="$(grep -E '^PBXNG_COMPOSE_FILE=' "$ENVF" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '" ')"
CF="${CF:-docker-compose.yml}"
dc(){ docker compose -f "$CF" "$@"; }
YES=0; ARGS=()
for a in "$@"; do case "$a" in --yes|-y) YES=1;; *) ARGS+=("$a");; esac; done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# Drena Asterisk solo si el `up -d` que viene lo va a recrear (segun --dry-run de
# compose). Si el dry-run no esta disponible, se drena igual: es gratis sin llamadas.
# $1 = perfiles, $2 = 1 para no preguntar.
drain_if_recreate(){
  [ -x "$DIR/asterisk-drain.sh" ] || return 0
  local plan
  if plan="$(COMPOSE_PROFILES="$1" dc --dry-run up -d 2>&1)"; then
    echo "$plan" | grep -Eqi 'asterisk.*(recreat|creat)' || return 0
  fi
  local y=(); [ "${2:-0}" = 1 ] && y=(--yes)
  "$DIR/asterisk-drain.sh" -f "$CF" "${y[@]+"${y[@]}"}"
}

svcs_of(){ case "$1" in
  core)     echo "postgres asterisk api dashboard" ;;
  turn)     echo "coturn" ;;
  ai)       echo "voz" ;;
  intercom) echo "go2rtc" ;;
  proxy)    echo "npm" ;;
  *)        echo "" ;; esac ; }

get_profiles(){ grep -E '^COMPOSE_PROFILES=' "$ENVF" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '"' | tr -d ' ' ; }
set_profiles(){ local v="$1"
  if grep -q '^COMPOSE_PROFILES=' "$ENVF" 2>/dev/null; then sed -i "s|^COMPOSE_PROFILES=.*|COMPOSE_PROFILES=$v|" "$ENVF"
  else echo "COMPOSE_PROFILES=$v" >> "$ENVF"; fi ; }
has(){ echo ",$1," | grep -q ",$2," ; }
add(){ local cur="$1" m="$2"; has "$cur" "$m" && { echo "$cur"; return; }; [ -z "$cur" ] && echo "$m" || echo "$cur,$m" ; }
del(){ echo "$1" | tr ',' '\n' | grep -vx "$2" | paste -sd, - ; }
valid(){ echo "$MODULES" | grep -qw "$1" ; }

cmd="${1:-status}"; mod="${2:-}"
case "$cmd" in
  status)
    echo "COMPOSE_PROFILES=$(get_profiles)"
    COMPOSE_PROFILES="$(get_profiles)" dc ps 2>/dev/null || true ;;
  enable)
    [ -n "$mod" ] && valid "$mod" || { echo "modulo invalido. usa: $MODULES"; exit 1; }
    new="$(add "$(get_profiles)" "$mod")"; set_profiles "$new"
    echo "→ activando '$mod' (perfiles: $new)"
    drain_if_recreate "$new" "$YES"
    COMPOSE_PROFILES="$new" dc up -d ;;
  disable)
    [ -n "$mod" ] && valid "$mod" || { echo "modulo invalido. usa: $MODULES"; exit 1; }
    [ "$mod" = core ] && { echo "core no se puede desactivar"; exit 1; }
    echo "→ desactivando '$mod' (destruyo: $(svcs_of "$mod"))"
    for s in $(svcs_of "$mod"); do dc --profile "$mod" rm -sf "$s" 2>/dev/null || true; done
    new="$(del "$(get_profiles)" "$mod")"; set_profiles "$new" ;;
  up)   drain_if_recreate "$(get_profiles)" "$YES"; COMPOSE_PROFILES="$(get_profiles)" dc up -d ;;
  down) # down tambien corta llamadas: mismo drenado que al recrear.
        [ -x "$DIR/asterisk-drain.sh" ] && "$DIR/asterisk-drain.sh" -f "$CF" $([ "$YES" = 1 ] && echo --yes)
        COMPOSE_PROFILES="$(get_profiles)" dc down ;;
  ps)   COMPOSE_PROFILES="$(get_profiles)" dc ps ;;
  reconcile)
    active="$(get_profiles)"
    drain_if_recreate "$active" 1
    COMPOSE_PROFILES="$active" dc up -d
    for m in $MODULES; do
      [ "$m" = core ] && continue
      if ! has "$active" "$m"; then
        for s in $(svcs_of "$m"); do dc --profile "$m" rm -sf "$s" 2>/dev/null || true; done
      fi
    done ;;
  backup)
    # Mismo camino que el cron (backup-cron.sh): backup-cli.js dentro de la API.
    # Sin args: crea uno y aplica la retencion BACKUP_KEEP del .env (default 14).
    shift || true
    keep="$(grep -E '^BACKUP_KEEP=' "$ENVF" 2>/dev/null | head -1 | cut -d= -f2- | tr -d '" ')"
    COMPOSE_PROFILES="$(get_profiles)" dc exec -T -e "BACKUP_KEEP=${keep:-14}" api node backup-cli.js "$@" ;;
  drain)
    [ -x "$DIR/asterisk-drain.sh" ] || { echo "falta $DIR/asterisk-drain.sh"; exit 1; }
    "$DIR/asterisk-drain.sh" -f "$CF" $([ "$YES" = 1 ] && echo --yes) ;;
  *) echo "uso: pbxng-ctl {status|enable <m>|disable <m>|up|down|ps|reconcile|backup [args]|drain} [--yes]  ·  modulos: $MODULES"; exit 1 ;;
esac
