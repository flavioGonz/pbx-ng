{
  "name": "pbxng-api",
  "version": "0.1.0",
  "description": "PBX-NG control plane API (ARI/AMI + PostgreSQL realtime provisioning)",
  "main": "app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node app.js",
    "test": "node --test test/*.test.js",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include='*.js' --test-coverage-exclude='eslint.config.js' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 test/*.test.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "ari-client": "^2.2.0",
    "asterisk-manager": "^0.2.0",
    "bcryptjs": "^3.0.3",
    "express": "^4.22.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "web-push": "^3.6.7",
    "ws": "^8.18.0"
  },
  "overrides": {
    "form-data": "^2.5.6",
    "qs": "^6.16.0",
    "cookiejar": "^2.1.4"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
